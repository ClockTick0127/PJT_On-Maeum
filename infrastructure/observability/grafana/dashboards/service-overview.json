{
  "uid": "nilm-service-overview",
  "title": "NILM · 서비스 가용성",
  "description": "기존 HTTP health와 TCP 연결 검사. TCP 성공은 업무 처리 정상 여부를 보장하지 않음.",
  "tags": [
    "nilm"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "refresh": "1s",
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"] },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "수집 대상 상태",
      "description": "Exporter 응답 여부. 실제 서비스 상태는 probe_success로 판단.",
      "datasource": {
        "type": "prometheus",
        "uid": "nilm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} / {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nilm-prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
