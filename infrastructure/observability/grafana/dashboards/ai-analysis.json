{
  "uid": "nilm-ai-analysis",
  "title": "NILM · AI 분석",
  "description": "모든 실시간 AI Consumer replica의 /metrics. 데이터 미발생은 No data, 수집 실패는 up=0.",
  "tags": [
    "nilm"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 3,
  "editable": false,
  "refresh": "1s",
  "timepicker": { "refresh_intervals": ["1s", "5s", "10s", "30s", "1m", "5m"] },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "AI instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nilm-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"ai-analysis\"}, instance)",
          "refId": "VariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AI 메트릭 수집 상태",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "nilm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "interval": "1s",
          "expr": "up{job=\"ai-analysis\",instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nilm-prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Manifest 모델",
      "description": "Manifest 메타데이터. 실제 모델 준비 상태 검증값은 아님.",
      "datasource": {
        "type": "prometheus",
        "uid": "nilm-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
