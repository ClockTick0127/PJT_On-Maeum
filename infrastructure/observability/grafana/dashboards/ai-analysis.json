          "expr": "nilm_analysis_model_info{job=\"ai-analysis\",instance=~\"$instance\"}",
          "legendFormat": "{{name}} / {{version}} / {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "nilm-prometheus"
          },
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "입력 처리량 · Consumer별",
      "description": "processed에는 버퍼 적재만 완료한 입력도 포함.",
      "datasource": {
        "type": "prometheus",
        "uid": "nilm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
