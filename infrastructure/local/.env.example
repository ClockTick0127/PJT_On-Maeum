# Local only. Copy to .env; keep existing DB credentials when reusing data.
POSTGRES_USER=nilm_admin
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=postgres
POSTGRES_PORT=5432
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local
KEYCLOAK_HOSTNAME=http://localhost:8090
JWT_ISSUER_URI=http://localhost:8090/realms/nilm
FRONTEND_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_SECURITY_ENABLED=true
NILM_SMOKE_CLIENT_SECRET=change-me-local-smoke
# Must match the existing mqtt/config/passwd. New files can be initialized below.
MQTT_USER=kafka_bridge_user
MQTT_PASS=change-me-local-bridge
MQTT_SIMULATOR_USER=simulator_user
MQTT_SIMULATOR_PASS=change-me-local-simulator
KAFKA_RAW_TOPIC=power.raw.v1
KAFKA_PARTITIONS=24
