{
  "realm": "nilm",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "USER"
      },
      {
        "name": "ADMIN"
      },
      {
        "name": "STAFF"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nilm-dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${FRONTEND_ORIGIN}/*"
      ],
      "webOrigins": [
        "${FRONTEND_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "nilm-smoke",
      "enabled": true,
      "publicClient": false,
      "secret": "${NILM_SMOKE_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "nilm-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "${NILM_BACKEND_CLIENT_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-nilm-backend",
      "enabled": true,
      "serviceAccountClientId": "nilm-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users"
        ]
      }
    }
  ]
}